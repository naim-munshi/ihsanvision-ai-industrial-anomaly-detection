# Copy to .env (which is Git-ignored), or export these privately in your shell.
# Directory contains both padim-bottle-seed42/model.ckpt and
# patchcore-bottle-seed42/model.ckpt, downloaded from your own trusted Kaggle run.
IHSANVISION_MODELS_DIR=/absolute/private/path/to/benchmark-bottle-seed42-2026-10-15

# Generate a private random secret. Never commit the actual value.
IHSANVISION_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
